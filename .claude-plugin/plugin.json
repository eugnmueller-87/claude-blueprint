{
  "name": "claude-blueprint",
  "description": "Guard rails that hold. Hooks block secrets and dangerous commands at the tool-call boundary, before the model's intent matters. The CLAUDE.md rules are each anchored to a dated incident, because a rule without a scar gets ignored.",
  "version": "1.0.0",
  "author": {
    "name": "Eugen Müller",
    "url": "https://github.com/eugnmueller-87"
  },
  "homepage": "https://github.com/eugnmueller-87/claude-blueprint",
  "repository": "https://github.com/eugnmueller-87/claude-blueprint",
  "license": "MIT",
  "keywords": [
    "boilerplate",
    "guardrails",
    "hooks",
    "secrets",
    "claude-md",
    "code-review",
    "python",
    "ai-agents"
  ],
  "skills": [
    "./.claude/skills/",
    "./.claude/skills/optional/"
  ],
  "agents": [
    "./.claude/agents/ai-agent-reviewer/ai-agent-reviewer.md",
    "./.claude/agents/code-reviewer/code-reviewer.md",
    "./.claude/agents/data-pipeline-reviewer/data-pipeline-reviewer.md",
    "./.claude/agents/doc-reviewer/doc-reviewer.md",
    "./.claude/agents/frontend-designer/frontend-designer.md",
    "./.claude/agents/performance-reviewer/performance-reviewer.md",
    "./.claude/agents/pr-test-analyzer/pr-test-analyzer.md",
    "./.claude/agents/procurement-domain-reviewer/procurement-domain-reviewer.md",
    "./.claude/agents/security-reviewer/security-reviewer.md",
    "./.claude/agents/silent-failure-hunter/silent-failure-hunter.md"
  ],
  "hooks": "./hooks/hooks.json"
}
