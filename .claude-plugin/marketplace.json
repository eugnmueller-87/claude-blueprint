{
  "name": "claude-blueprint",
  "id": "claude-blueprint",
  "owner": {
    "name": "Eugen Müller",
    "url": "https://github.com/eugnmueller-87"
  },
  "metadata": {
    "description": "Guard rails that hold: hooks that block secrets deterministically, plus CLAUDE.md rules each anchored to a real incident.",
    "version": "1.0.0"
  },
  "plugins": [
    {
      "name": "claude-blueprint",
      "source": "./",
      "description": "The full blueprint as a plugin: 8 hooks that block secrets and dangerous commands at the tool-call boundary, 10 focused reviewers, and 20 skills including incident-rule. Security is deterministic; everything else is advisory.",
      "version": "1.0.0",
      "author": {
        "name": "Eugen Müller",
        "url": "https://github.com/eugnmueller-87"
      },
      "license": "MIT",
      "keywords": [
        "boilerplate",
        "guardrails",
        "hooks",
        "secrets",
        "claude-md",
        "code-review",
        "python"
      ],
      "category": "workflow",
      "strict": false,
      "skills": [
        "./.claude/skills/",
        "./.claude/skills/optional/"
      ],
      "agents": [
        "./.claude/agents/ai-agent-reviewer/ai-agent-reviewer.md",
        "./.claude/agents/code-reviewer/code-reviewer.md",
        "./.claude/agents/data-pipeline-reviewer/data-pipeline-reviewer.md",
        "./.claude/agents/doc-reviewer/doc-reviewer.md",
        "./.claude/agents/frontend-designer/frontend-designer.md",
        "./.claude/agents/performance-reviewer/performance-reviewer.md",
        "./.claude/agents/pr-test-analyzer/pr-test-analyzer.md",
        "./.claude/agents/procurement-domain-reviewer/procurement-domain-reviewer.md",
        "./.claude/agents/security-reviewer/security-reviewer.md",
        "./.claude/agents/silent-failure-hunter/silent-failure-hunter.md"
      ],
      "hooks": "./hooks/hooks.json"
    },
    {
      "name": "incident-rule",
      "source": "./",
      "description": "One skill, standalone. Turns the afternoon you just lost into a permanent CLAUDE.md rule in your own words, with the incident attached. Refuses to write one when nothing was actually at stake.",
      "version": "1.0.0",
      "author": {
        "name": "Eugen Müller",
        "url": "https://github.com/eugnmueller-87"
      },
      "license": "MIT",
      "keywords": [
        "claude-md",
        "postmortem",
        "retrospective",
        "documentation"
      ],
      "category": "workflow",
      "strict": false,
      "skills": [
        "./.claude/skills/incident-rule"
      ]
    }
  ]
}
