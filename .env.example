# .env.example — documents every env var; holds NO real values.
# Copy to .env (git-ignored) and fill in. NEVER commit .env.
# In code, read these via os.getenv("NAME") — never hardcode the value.

# ─── LLM / AI provider keys ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
OPENAI_API_KEY=sk-proj-your-key-here

# ─── Telegram bot (python-telegram-bot on Railway) ────────
TELEGRAM_BOT_TOKEN=0000000000:AA-your-bot-token-here

# ─── Data stores ──────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Cloud / infra ────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA-your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
GITHUB_TOKEN=ghp_your-token-here

# ─── App config (non-secret defaults are fine to commit here) ─
LOG_LEVEL=INFO
ENV=development
